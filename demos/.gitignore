# renders are rebuilt from the compositions; they do not belong in git
*/renders/
*/layout.json
*/*/renders/
*/*/layout.json

# an operation demo plays copies of other demos' renders — rebuilt, never stored
*/media/
*/cuts/

# beat maps are regenerated from the music bed, which is not shipped either
*/beats/

# each demo's assets/ is a junction to _assets/ — committing it would store
# every font once per demo
[0-9]*/assets/
[0-9]*/*/assets/

# The music bed is NOT redistributed: its licence has not been verified for
# that. Drop a track you have cleared at _assets/music/bed.mp3 before rendering,
# and run scripts/cue_sheet.mjs to produce its licence record.
_assets/music/

# Bundled SFX from the renderer's own asset library — used for rendering, not
# redistributed, for the same reason as the music bed.
_assets/sfx/

# Voice takes — a recorded voice is a person's, and TTS output is regenerated;
# neither is stored in a public repository
_assets/voice/
